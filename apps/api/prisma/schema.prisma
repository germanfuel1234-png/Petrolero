// Modelo de datos — Sistema de gestión de válvulas (Oil & Gas)
//
// Nota sobre PostGIS: la columna `geom` de Pozo NO se declara acá. Se agrega por migración SQL
// como columna generada a partir de lat/lng (ver migrations/.../postgis.sql). Prisma maneja
// lat/lng como Float —CRUD simple y tipado— y las consultas espaciales usan $queryRaw sobre geom.

generator client {
  provider = "prisma-client-js"
}

// La extensión PostGIS ya viene instalada en la imagen postgis/postgis del docker-compose,
// así que no se declara acá: si Prisma la gestionara, marcaría como "drift" las extensiones
// extra que trae la imagen (tiger_geocoder, topology) en cada migración.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Zona {
  id     String @id @default(cuid())
  nombre String @unique

  // Centro aproximado de la zona, para encuadrar el mapa.
  lat Float
  lng Float

  pozos Pozo[]

  creadoEn DateTime @default(now())
}

model Pozo {
  id     String @id @default(cuid())
  nombre String

  // Restrict y no Cascade: borrar una zona no puede arrastrarse los pozos y, con ellos,
  // el historial de mantenimiento. Para sacar una zona de circulación hay que archivar
  // antes sus pozos.
  zona   Zona   @relation(fields: [zonaId], references: [id], onDelete: Restrict)
  zonaId String

  // TODO[CLIENTE]: estas coordenadas vienen del seed sintético. Hacen falta las ubicaciones reales
  // de los pozos para que el mapa y el agrupamiento por cercanía sirvan de verdad.
  lat Float
  lng Float

  /// Columna geoespacial que PostgreSQL deriva sola de lat/lng (ver la migración
  /// postgis_geom_pozo). Se declara como Unsupported para que Prisma sepa que existe:
  /// sin esta línea, cualquier `prisma migrate dev` futuro la detecta como columna
  /// sobrante y la BORRA, rompiendo el agrupamiento por cercanía.
  /// No se lee ni escribe desde Prisma Client; las consultas espaciales usan $queryRaw.
  geom Unsupported("geography(Point, 4326)")?

  /// Borrado lógico. Un pozo archivado desaparece de mapas, listados y KPIs, pero
  /// conserva su historial de pruebas de hermeticidad, que es dato de seguridad.
  archivadoEn DateTime?
  archivadoPor String?
  motivoArchivado String?

  valvulas Valvula[]

  creadoEn DateTime @default(now())

  // El nombre es único DENTRO de la zona, no en todo el sistema: en la industria es
  // habitual que dos yacimientos repitan la numeración de pozos.
  @@unique([zonaId, nombre])
  @@index([zonaId])
  @@index([archivadoEn])
  // Índice espacial del clustering por cercanía. Declarado acá por el mismo motivo que
  // la columna geom: si Prisma no lo conoce, lo borra en la próxima migración.
  @@index([geom], map: "pozo_geom_idx", type: Gist)
}

model Valvula {
  id String @id @default(cuid())

  // Restrict: una válvula con historial no se borra. Si se desmonta del pozo, se archiva.
  pozo   Pozo   @relation(fields: [pozoId], references: [id], onDelete: Restrict)
  pozoId String

  // Código corto visible en el visor 3D, ej "V-1".
  codigo String
  nombre String

  // VERTICAL | HORIZONTAL — del audio: "cuatro en vertical, cinco en horizontal".
  // La cantidad de válvulas por pozo es variable: no hay ningún límite fijo acá.
  orientacion String

  // Posición dentro de su grupo de orientación, para ubicarla en el modelo 3D.
  orden Int

  /// Borrado lógico, mismo criterio que Pozo: conserva el historial de la válvula.
  archivadoEn DateTime?

  eventos EventoMantenimiento[]

  creadoEn DateTime @default(now())

  @@unique([pozoId, codigo])
  @@index([pozoId])
  @@index([archivadoEn])
}

/// Historial de mantenimiento. APPEND-ONLY en sentido estricto: no se actualiza, no se
/// borra, y tampoco se puede borrar por arrastre al eliminar la válvula o el pozo
/// (por eso las relaciones son Restrict y el retiro de equipos es por archivado).
/// Cada inspección es un registro nuevo; el estado actual de una válvula es su evento más reciente.
/// Se diseña así porque la prueba de hermeticidad es un dato de seguridad y su historial
/// tiene que ser reconstruible.
model EventoMantenimiento {
  id String @id @default(cuid())

  valvula   Valvula @relation(fields: [valvulaId], references: [id], onDelete: Restrict)
  valvulaId String

  fecha            DateTime
  engraseRealizado Boolean  @default(true)

  // OK | NEGATIVO
  resultadoPrueba String

  // Calculada por el backend: fecha + 1 año cuando el resultado es OK. Null si fue NEGATIVO.
  proximaRevision DateTime?

  observaciones String?

  // TODO[CLIENTE]: se guarda quién cargó el registro, pero no hay firma digital ni validación
  // de un segundo responsable. Confirmar si la normativa de la empresa exige trazabilidad formal.
  registradoPor String?

  accionCorrectiva AccionCorrectiva?

  creadoEn DateTime @default(now())

  @@index([valvulaId, fecha])
}

/// Catálogo de acciones correctivas. Vive en base (no es un enum) justamente porque
/// el listado completo lo tiene que confirmar el cliente: así se agregan filas sin tocar código.
model TipoAccionCorrectiva {
  id          String  @id @default(cuid())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  acciones AccionCorrectiva[]
}

model AccionCorrectiva {
  id String @id @default(cuid())

  // Relación 1-a-1: una acción nace de un evento con prueba NEGATIVA.
  evento   EventoMantenimiento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  eventoId String              @unique

  tipoAccion   TipoAccionCorrectiva @relation(fields: [tipoAccionId], references: [id])
  tipoAccionId String

  // PENDIENTE | PLANIFICADA | COMPLETADA
  estado String @default("PENDIENTE")

  planSemanal   PlanSemanal? @relation(fields: [planSemanalId], references: [id])
  planSemanalId String?

  creadoEn DateTime @default(now())

  @@index([estado])
  @@index([tipoAccionId])
  @@index([planSemanalId])
}

model PlanSemanal {
  id     String @id @default(cuid())
  nombre String

  // Lunes de la semana planificada.
  semanaInicio DateTime

  // Se completa cuando se avisa al equipo de campo.
  notificadoEn DateTime?

  acciones AccionCorrectiva[]

  creadoEn DateTime @default(now())

  @@index([semanaInicio])
}

/// TODO[CLIENTE]: se asumen 2 roles (SUPERVISOR, TECNICO). Falta confirmar si hay más perfiles
/// (gerencia, HSE, auditoría) y qué puede ver/editar exactamente cada uno.
model Usuario {
  id     String @id @default(cuid())
  email  String @unique
  nombre String

  // Hash bcrypt. Nunca se guarda la contraseña en texto plano.
  passwordHash String

  // SUPERVISOR | TECNICO
  rol String

  activo Boolean @default(true)

  creadoEn DateTime @default(now())
}
