{
  "compilerOptions": {
    "target": "ES2022",
    // CommonJS para que la API (NestJS, CJS) pueda requerirlo.
    // Vite consume CJS sin problema, así que el frontend no se ve afectado.
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
