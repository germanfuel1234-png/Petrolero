{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
    // Sin `paths` a propósito: @petrolero/shared se resuelve por el symlink de npm
    // workspaces hacia packages/shared/dist. Si se mapeara al código fuente, TypeScript
    // trataría esos archivos como parte de este proyecto y anidaría la salida
    // (dist/apps/api/src/main.js en vez de dist/main.js).
  },
  // Solo src: si se incluyera prisma/, el rootDir subiría al raíz de la app y la salida
  // quedaría anidada (dist/src/main.js). El seed corre con tsx, no necesita compilarse.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "prisma"]
}
